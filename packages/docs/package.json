{
  "name": "@popcornt/qjudge-docs",
  "version": "0.2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./content": {
      "types": "./dist/content/index.d.ts",
      "import": "./dist/content/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && sass --load-path=../../node_modules src/styles.scss dist/styles.css --no-source-map && node scripts/copy-fonts.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@carbon/react": "^1.96.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.2"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.70.0",
    "@ibm/plex": "6.4.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.25",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.14.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.0.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PopcornT/qjudge-docs-framework.git",
    "directory": "packages/docs"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
