{
  "name": "qjudge-docs-framework",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/docs",
    "examples/education",
    "examples/business"
  ],
  "scripts": {
    "build": "npm run build -w @popcornt/qjudge-docs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:examples": "npm run build -w @popcornt/qjudge-docs-education && npm run build -w @popcornt/qjudge-docs-business",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run build && npm run build:examples && npm test && npm run test:browser",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@carbon/react": "1.96.0",
    "@playwright/test": "^1.57.0",
    "@react-router/node": "^7.18.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "7.18.2",
    "sass": "^1.94.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "8.3.6",
    "vitest": "4.1.12"
  }
}
